{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FaceGuard",
  "version": "1.0.0",
  "identifier": "com.faceguard.app",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FaceGuard",
        "width": 880,
        "height": 720,
        "minWidth": 800,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "resources/icons/32x32.png",
      "resources/icons/128x128.png",
      "resources/icons/icon.ico"
    ]
  }
}
